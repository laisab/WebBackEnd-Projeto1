<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{titulo}}</title>
</head>

<body>
    <h1>{{titulo}}</h1>

    <ul>
        <li>Nome: {{dados.nome}}</li>
        <li>CPF: {{dados.cpf}}</li>
        <li>Email: {{dados.email}}</li>
        <li>Endereço: {{dados.endereco}}</li>
    </ul>

    <a href="/cliente/logout">
        <button type="submit">Sair</button>
    </a>

    <form action="/cliente/apagar" method="POST">
        <input type="hidden" name="cpf" value="{{dados.cpf}}">
        <button type="submit">Apagar conta</button>
    </form>
</body>

</html>