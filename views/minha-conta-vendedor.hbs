<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{titulo}}</title>
</head>

<body>
    <h1>{{titulo}}</h1>

    <ul>
        <li>Nome: {{dados.nome}}</li>
        <li>CNPJ: {{dados.cnpj}}</li>
        <li>Endereço: {{dados.endereco}}</li>
    </ul>

    <a href="/produto/cadastro">
        <button type="submit">Cadastrar produtos</button>
    </a>

    <form action="/vendedor/apagar" method="POST">
        <input type="hidden" name="cnpj" value="{{dados.cnpj}}">
        <button type="submit">Apagar conta</button>
    </form>
</body>

</html>